# ==============================================================================
# Q-SAT Adaptive Ground Station - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust the variables for your local setup.
# Do NOT commit '.env' containing real secrets or environment-specific values.
# ==============================================================================

# System Identification & Mode
SYSTEM_NAME="Q-SAT Adaptive Ground Station"
VERSION="0.1.0"
ENVIRONMENT_MODE="simulation"      # Options: 'simulation' or 'mqtt'

# API Server Configuration
API_HOST="0.0.0.0"
API_PORT=8000
DEBUG=false

# Ground Station Geographic Reference (Default: NIT Trichy, India)
GROUND_STATION_LAT=10.7905
GROUND_STATION_LON=78.7047
GROUND_STATION_ALT=80.0
MIN_ELEVATION=10.0

# Simulation Dynamics
SIMULATION_SPEED=1.0
SIMULATION_TIME_STEP=1.0
RANDOM_SEED=42

# MQTT Broker Configuration (Eclipse Mosquitto)
MQTT_BROKER="localhost"
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_TOPIC_ENVIRONMENT="qsat/environment"
MQTT_TOPIC_SATELLITE="qsat/satellite"
MQTT_TOPIC_QKD="qsat/qkd"
MQTT_TOPIC_CONTROL="qsat/control"
MQTT_TOPIC_ALERTS="qsat/alerts"

# Optical & BB84 Quantum Channel Parameters
QKD_DETECTOR_EFFICIENCY=0.10
DARK_COUNT_RATE=1e-5
BASE_QBER=0.01
BASIS_MATCHING_PROBABILITY=0.50
ERROR_CORRECTION_EFFICIENCY=1.16
OPTICAL_WAVELENGTH_NM=850.0

# Actuator & Control Constraints
MAX_TRANSMISSION_POWER=100.0
